# Required — get one at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional
# ANTHROPIC_MODEL=claude-opus-5-5
# CHAT_EFFORT=low            # low | medium | high
# LEAD_WEBHOOK_URL=          # POST target for captured leads until storage is decided

# monday.com workflow webhook — each chat's lead is POSTed here once (server-side only).
# Body: {"name","email","phone","service","address","sqft","details"}
MONDAY_LEAD_WEBHOOK_URL=

# "New Chatbot Lead" email via Resend (https://resend.com) — server-side only.
# Sent when a chat's lead is first created and on every "Get a quote" form submission.
RESEND_API_KEY=
LEAD_NOTIFY_TO="noor@shinenos.com,info@shinenos.com"
# Sender — its domain must be verified in Resend
LEAD_NOTIFY_FROM="SHINENOS Chatbot <leads@shinenos.com>"
# Optional
# LEAD_NOTIFY_BOARD_URL=https://shinenos.monday.com/boards/18440107184
# LEAD_NOTIFY_TIMEZONE=America/New_York
